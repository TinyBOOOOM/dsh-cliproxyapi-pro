{
  "name": "dsh-cliproxyapi-pro",
  "version": "1.9.0",
  "description": "CLIProxyAPI (CPA) provider for DeepSeek Harness — multiple accounts, model sync over native protocols, per-credential quota, and optional image / video generation.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cliproxyapi",
    "cli-proxy-api",
    "cpa",
    "llm-provider"
  ],
  "author": "bowen (https://github.com/TinyBOOOOM)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyBOOOOM/dsh-cliproxyapi-pro.git"
  },
  "homepage": "https://github.com/TinyBOOOOM/dsh-cliproxyapi-pro#readme",
  "bugs": {
    "url": "https://github.com/TinyBOOOOM/dsh-cliproxyapi-pro/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/check.mjs && node --test \"tests/**/*.test.mjs\"",
    "pack:check": "npm pack --dry-run"
  }
}
